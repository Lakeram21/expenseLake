{
  "name": "expenselake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-expenselake --only firestore \"VITE_RULES_TEST=true vitest run src/test/firestore.rules.test.ts\"",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.0.0",
    "firebase-tools": "15.34.1",
    "jsdom": "25.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1"
  }
}
